{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infragr.am/schemas/bundle-v1.schema.json",
  "title": "Infragr.am sanitized Terraform bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resources", "sanitization"],
  "properties": {
    "schema_version": { "const": 1 },
    "terraform_version": { "type": "string" },
    "terraform_format_version": { "type": "string" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "type", "name"],
        "properties": {
          "address": { "type": "string" },
          "module_address": { "type": "string" },
          "mode": { "type": "string" },
          "type": { "type": "string" },
          "name": { "type": "string" },
          "provider_name": { "type": "string" },
          "actions": { "type": "array", "items": { "type": "string" } },
          "values": { "type": "object" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "via": { "type": "string" }
        }
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "sensitive_paths_removed", "denied_keys_removed"],
      "properties": {
        "profile": { "const": "standard" },
        "sensitive_paths_removed": { "type": "integer", "minimum": 0 },
        "denied_keys_removed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
